<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Locm</RootNamespace>
    <AssemblyName>LocmBot</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <!-- экспериментальный код (#if EXPERIMENTS) собирается локально, но вырезается из склейки tools/bundle.py -->
    <DefineConstants>$(DefineConstants);EXPERIMENTS</DefineConstants>
  </PropertyGroup>

</Project>
